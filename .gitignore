# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# テンプレートは秘密を含まない設定ドキュメントなので追跡する。
# （`.env*` に飲み込まれて一度も追跡されていなかった）
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal local server data (synced via /api/store)
.data/
.design/

server.log

# ============================================================
# iOS/Android の署名情報（**このリポジトリは public**）
# ============================================================
# ⚠️ 絶対にコミットしない。漏れると第三者が大翔名義のアプリを配信できてしまう。
#    fastlane は実行時に fastlane/../dist-cert.p12 へ実ファイルを書き出すので、
#    ローカルで fastlane を触ると本当にここに置かれる。
*.p12
*.p8
*.mobileprovision
*.cer
*.certSigningRequest
dist-cert.p12
build/

# fastlane の実行時生成物
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/README.md

# Capacitor / iOS のビルド生成物（cap sync でCI上で再生成される）
ios/App/App/public
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/App/Pods
ios/DerivedData
ios/App/build
android/app/build
android/build
android/.gradle
android/local.properties
android/app/src/main/assets/public
android/app/src/main/assets/capacitor.config.json

# 作業中の一時ファイル
.did
.rid
.runid*

# dev サーバーのログ
.dev3014.log
.local3000.log
.diag/

# 監査スクリプトの出力
.audit-result.txt

# ベンチ・スクショの出力（実行のたびに変わるので追跡しない）
.bench/
.shots-local/
.shots-retention/
