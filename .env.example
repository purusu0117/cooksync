# CookSync 環境変数テンプレート。
# 開発・試験・本番の設定と保存先を分離する。詳細は DEPLOY.md。
# AIは明示的な照合と有効化が必要。CLIや別組織への自動切替はしない。
# 秘密値をチャット・ログ・Gitへ出さない。実キーの発行/設定と呼出しは別承認。

# ============================================================
# AI（未設定なら停止。数量・在庫・購入・調理の手動操作は利用可能）
# ============================================================
# 対象組織と所属を照合したCookSync専用キーをサーバー側に設定する。
ANTHROPIC_API_KEY=
COOKSYNC_AI_ENABLED=0
COOKSYNC_AI_ENVIRONMENT=
COOKSYNC_AI_ORG_ID=
COOKSYNC_AI_KEY_SHA256=
# 金額は整数micro-USD（1ドル=1000000）。上限・残高・期限を承認後に設定する。
COOKSYNC_AI_BUDGET_MICRO_USD=
COOKSYNC_AI_VERIFIED_CREDIT_MICRO_USD=
COOKSYNC_AI_BALANCE_VERIFIED_AT=
COOKSYNC_AI_BALANCE_RECHECK_AT=
COOKSYNC_AI_CREDIT_EXPIRES_AT=
COOKSYNC_PUBLIC_ORIGIN=
# ローカルでの動画追加抽出を許可する場合のみ。Vercelでは無効。
COOKSYNC_VIDEO_EXTRACTION_APPROVED=0

# モデル（任意）。未設定なら MAIN=claude-sonnet-5 / CHEAP=claude-haiku-4-5。
# MAIN  … レシピ探索・写真からレシピ（品質が売りなので下げない）
# CHEAP … 食材名の読み取り・校正（単価1/3）
COOKSYNC_AI_MODEL=
COOKSYNC_AI_MODEL_CHEAP=

# ============================================================
# コストの安全装置（公開時に必ず設定する）
# ============================================================
# CookSync自身の月間予算（円）。未設定なら 3000。
# ⚠️ Anthropic Console の支出上限は**組織単位**で他プロジェクトと食い合うので、
#    CookSync単体を止めるのはこちらの役目。原価ログの累計＋これから使う分で事前判定する。
COOKSYNC_MONTHLY_BUDGET_YEN=

# 全体の月間AI呼び出し回数の上限（最終防衛線）。未設定なら 300。
COOKSYNC_MONTHLY_AI_CAP=

# 同一IPからの1日あたりAI呼び出し上限。未設定なら 30。
# uidを作り直して無料枠をリセットする回避を潰すためのもの。
COOKSYNC_IP_DAILY_CAP=

# 円換算に使う為替（原価表示用）。未設定なら 155。
COOKSYNC_USD_JPY=

# ローカルでも枠を強制したいとき（動作確認用）。1 で有効。
COOKSYNC_ENFORCE_QUOTA=

# ============================================================
# 認証・セッション（公開時に必須）
# ============================================================
# セッションCookieの署名鍵。**16文字以上のランダム文字列**。
# 本番で未設定だとセッションを発行せずエラーにする（弱い鍵で運用しないため）。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ これを変更すると全ユーザーが強制ログアウトになる。
COOKSYNC_SESSION_SECRET=

# Googleログイン（1人1アカウントの担保）。両方揃うと有効になる。
# Google Cloud Console → APIとサービス → 認証情報 → OAuth 2.0 クライアント ID（ウェブアプリケーション）
# 承認済みリダイレクトURIに  https://<本番ドメイン>/api/auth/google/callback  を登録する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# リダイレクトURIを明示したい場合（未設定ならリクエストのオリジンから自動生成）
COOKSYNC_OAUTH_REDIRECT_URI=

# IPハッシュのソルト（IPを生で保存しないため）。未設定でも動くが公開時は設定推奨。
COOKSYNC_IP_SALT=

# 管理画面の鍵。未設定ならアクセスを拒否する。
COOKSYNC_ADMIN_KEY=

# ============================================================
# データ保存（公開時に必須）
# ============================================================
# Upstash Redis。Vercelで未設定なら停止。個人ローカルのみJSON保存を使える。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# プッシュ通知
# ============================================================
# 送り先は2種類あり、sendPush() が自動で振り分ける。
#   ブラウザ/PWA … Web Push（VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY。未設定ならローカルで自動生成）
#   iOSアプリ    … APNs（下記）。WKWebViewは Web Push を受け取れないので必須。
#
# APNs認証キー(.p8)は Apple Developer → Keys で作る（Apple Push Notifications service を有効に）。
# 作った .p8 を base64 にして APNS_KEY_BASE64 に入れる（**キー本体はリポジトリに置かない**）:
#   Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("AuthKey_XXXXXXXXXX.p8"))
# 3つとも未設定ならAPNs送信をスキップするだけ（アプリは落ちない）。
APNS_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
# バンドルID。未設定なら com.daito.cooksync
APNS_BUNDLE_ID=
# "0" でサンドボックス（Xcodeから直接入れた開発ビルド用）。未設定＝本番（TestFlight/App Store）
APNS_PRODUCTION=

# ============================================================
# まとめて買う導線（アフィリエイト）／任意
# ============================================================
# 買い物リストとレシピ詳細に出る「ネットで注文して届けてもらう」の送客先。
# **未設定なら導線ごと画面に出ない**ので、登録が済んだ先から1つずつ入れていけばよい。
# 定義は src/lib/affiliate.ts（表示順もそこの配列順）。
#
# 入れる値：ASPの管理画面が出す「テキスト用」広告リンクのURL（https:// で始まるもの）。
#   ⚠️ <a href="…">…</a> のHTMLごと貼らない。href の中身だけ。
#   ⚠️ https 以外は無視される（App StoreのATSでも http は開けない）。
#
# 取得先: 楽天西友=A8.net / Oisix=A8.net / らでぃっしゅぼーや=バリューコマース
#         ヨシケイ=A8.net・afb・アクセストレード
NEXT_PUBLIC_AFF_RAKUTEN_SEIYU=
NEXT_PUBLIC_AFF_OISIX=
NEXT_PUBLIC_AFF_RADISH=
NEXT_PUBLIC_AFF_YOSHIKEI=

# 提携前に見た目だけ確認したいとき。1 で公式サイトの素リンクを表示する（成果は付かない）。
# 本番では設定しないこと（報酬にならないリンクを出すだけになる）。
NEXT_PUBLIC_SHOPPABLE_PREVIEW=

# ============================================================
# 任意
# ============================================================
# レシピ画像生成プロバイダ。未設定なら画像生成は無効＝イラスト表示。
IMAGE_API_KEY=

# 決済（プレミアム課金を使う場合）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
