# CookSync 環境変数テンプレート。
# ローカル個人運用では何も設定しなくて動く（ローカルの claude CLI + JSONファイル）。
# 公開（Vercel等）時にこれらを設定する。詳細は DEPLOY.md。
#
# ⚠️⚠️ ANTHROPIC_API_KEY をローカルの .env.local に入れないこと ⚠️⚠️
#   ai.ts は「キーがあればAPI経由」に切り替わる（USE_API）。
#   ローカルは claude.exe 経由＝Maxプラン枠で**原価0**なので、キーを入れると
#   大翔自身の開発・動作確認まで従量課金になる。キーは**公開環境(Vercel)にだけ**入れる。

# ============================================================
# AI（公開時に必須）
# ============================================================
# Anthropic APIキー。**CookSync専用Workspaceのキーを使う**こと。
# 支出上限は組織単位でも効くので、Workspaceを分けないと CashSync と食い合う。
#   組織 $50 ＞ CookSync Workspace $20 ＋ 他 という構成にしてある（2026-07-31）。
ANTHROPIC_API_KEY=

# モデル（任意）。未設定なら MAIN=claude-sonnet-5 / CHEAP=claude-haiku-4-5。
# MAIN  … レシピ探索・写真からレシピ（品質が売りなので下げない）
# CHEAP … 食材名の読み取り・校正（単価1/3）
COOKSYNC_AI_MODEL=
COOKSYNC_AI_MODEL_CHEAP=

# ============================================================
# コストの安全装置（公開時に必ず設定する）
# ============================================================
# CookSync自身の月間予算（円）。未設定なら 3000。
# ⚠️ Anthropic Console の支出上限は**組織単位**で他プロジェクトと食い合うので、
#    CookSync単体を止めるのはこちらの役目。原価ログの累計＋これから使う分で事前判定する。
COOKSYNC_MONTHLY_BUDGET_YEN=

# 全体の月間AI呼び出し回数の上限（最終防衛線）。未設定なら 300。
COOKSYNC_MONTHLY_AI_CAP=

# 同一IPからの1日あたりAI呼び出し上限。未設定なら 30。
# uidを作り直して無料枠をリセットする回避を潰すためのもの。
COOKSYNC_IP_DAILY_CAP=

# 円換算に使う為替（原価表示用）。未設定なら 155。
COOKSYNC_USD_JPY=

# ローカルでも枠を強制したいとき（動作確認用）。1 で有効。
COOKSYNC_ENFORCE_QUOTA=

# ============================================================
# 認証・セッション（公開時に必須）
# ============================================================
# セッションCookieの署名鍵。**16文字以上のランダム文字列**。
# 本番で未設定だとセッションを発行せずエラーにする（弱い鍵で運用しないため）。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ これを変更すると全ユーザーが強制ログアウトになる。
COOKSYNC_SESSION_SECRET=

# Googleログイン（1人1アカウントの担保）。両方揃うと有効になる。
# Google Cloud Console → APIとサービス → 認証情報 → OAuth 2.0 クライアント ID（ウェブアプリケーション）
# 承認済みリダイレクトURIに  https://<本番ドメイン>/api/auth/google/callback  を登録する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# リダイレクトURIを明示したい場合（未設定ならリクエストのオリジンから自動生成）
COOKSYNC_OAUTH_REDIRECT_URI=

# IPハッシュのソルト（IPを生で保存しないため）。未設定でも動くが公開時は設定推奨。
COOKSYNC_IP_SALT=

# 管理画面 /api/admin/stats?key=… の鍵。未設定ならソース内の既定値。
COOKSYNC_ADMIN_KEY=

# ============================================================
# データ保存（公開時に必須）
# ============================================================
# Upstash Redis。未設定ならローカルJSON（.data/）にフォールバックする。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# 任意
# ============================================================
# レシピ画像生成プロバイダ。未設定なら画像生成は無効＝イラスト表示。
IMAGE_API_KEY=

# 決済（プレミアム課金を使う場合）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
